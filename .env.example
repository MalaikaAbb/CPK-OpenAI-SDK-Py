# CopilotKit + OpenAI Agents SDK (Python) test suite
#
# Copy this file twice — the two processes read their own environment:
#
#   cp .env.example backend/.env
#   cp .env.example frontend/.env.local

# ---------------------------------------------------------------- backend

# Required. The OpenAI Agents SDK's client reads it (Quickstart step 2).
OPENAI_API_KEY=your_openai_api_key

# Optional (Quickstart): send model calls to another OpenAI-compatible server.
# OPENAI_BASE_URL=

# Reasoning pages' model (demo_agents/_common.py, harness glue). Defaults to MODEL.
# REASONING_MODEL=

# Model for every page-specific agent (demo_agents/_common.py, harness glue).
# Defaults to gpt-6-luna, the literal the Components page prints.
# The Quickstart's own agent sets no model and uses the SDK default.
# MODEL=gpt-6-luna

# ---------------------------------------------------------------- frontend

# Where the Copilot Runtime reaches the agent server. Leave it UNSET for the
# default ports: the published runtimes disagree on what it means. The
# Quickstart's route reads it as the full endpoint URL
# (http://localhost:8000/agent); the Voice page's route reads it as the server
# origin and appends /voice. The harness runtimes only use its origin.
# AGENT_URL=http://localhost:8000/agent

# CopilotKit Intelligence licence key — Threads Drawer and Headless Threads.
# Without it those routes show their locked view.
# CPK_INTELLIGENCE_API_KEY=your_license_key

# Voice page: transcription key (can be the same as OPENAI_API_KEY).
# OPENAI_TRANSCRIPTION_API_KEY=
# OPENAI_TRANSCRIPTION_BASE_URL=

# Set to `off` to disable the CopilotKit inspector on every route.
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=off
